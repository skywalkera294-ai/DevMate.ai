# DevMate AI API — environment template
# Copy to `.env` for local dev, or set these as environment variables on your
# hosting platform (platform vars override this file).

# Core
PORT=4000
NODE_ENV=production

# Public URL of the web frontend (used for OAuth redirects)
FRONTEND_URL=http://localhost:3000

# Auth
# Generate a long random secret: `openssl rand -hex 32`
JWT_SECRET=change-me
DATABASE_URL=file:./dev.db

# ---- AI / LLM ----
# provider: "offline" (built-in rule engine, zero dependencies, works anywhere)
#   or "openai-compatible" (use any OpenAI-compatible endpoint)
AI_PROVIDER=offline
AI_MODEL=gpt-4o-mini

# Set OPENAI_API_KEY to enable the LLM. Works with OpenAI or any compatible
# provider (OpenRouter, Azure, Groq, Together, Ollama, LM Studio, etc.) by
# pointing OPENAI_BASE_URL at it. Empty key = offline fallback engine.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Examples:
#   OpenAI:        AI_PROVIDER=openai-compatible, OPENAI_BASE_URL=https://api.openai.com/v1
#   OpenRouter:    OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   Ollama (local):AI_PROVIDER=openai-compatible, OPENAI_BASE_URL=http://localhost:11434/v1, OPENAI_API_KEY=ollama

# ---- GitHub integration (import repos, OAuth) ----
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Uploaded file storage
UPLOAD_DIR=uploads
