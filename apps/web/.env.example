# DevMate AI web — environment template
# For local dev copy to `.env.local`. On a host (Vercel/Netlify/Render), set
# these as build-time environment variables.

# Base URL of the deployed API (used directly by the browser for API calls)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public URL of this web app (used for OAuth redirects / links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
