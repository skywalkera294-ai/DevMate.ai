# ===== DevMate AI =====
# Copy to .env and adjust. Everything runs FREE out of the box (offline AI engine + SQLite).

# ---- Core ----
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string

# ---- Database (default: SQLite, zero setup) ----
# For PostgreSQL in production, uncomment and set:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devmate
DATABASE_URL=file:./dev.db

# ---- AI provider ----
# "offline" = built-in free engine (default, no keys, works fully)
# "openai-compatible" = point at ANY OpenAI-compatible endpoint (OpenAI, Groq, Mistral,
#   Gemini via its OpenAI endpoint, local Ollama, etc.) and set the vars below.
AI_PROVIDER=offline
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# ---- GitHub integration (free) ----
# EITHER a Personal Access Token (classic, repo + read:user)...
GITHUB_TOKEN=
# ...OR a GitHub OAuth App (create free at github.com/settings/developers):
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Google OAuth (optional, create free at console.cloud.google.com) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Uploads (local disk by default; S3-compatible optional) ----
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ---- Rate limiting ----
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
